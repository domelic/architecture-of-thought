#!/bin/bash
#
# DCF Workflow Runner
# Chains DCF skill modes with checkpoints between steps
#
# CAUTION: Workflows are scaffolding, not standard practice.
# Each transition should be a genuine checkpoint. The goal is
# to internalize when each mode fits, then choose deliberately.

set -eo pipefail

readonly VERSION="1.0.0"
readonly SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"

# Colors (disabled if not a terminal)
if [[ -t 1 ]]; then
    readonly RED='\033[0;31m'
    readonly GREEN='\033[0;32m'
    readonly YELLOW='\033[1;33m'
    readonly BLUE='\033[0;34m'
    readonly BOLD='\033[1m'
    readonly NC='\033[0m'
else
    readonly RED=''
    readonly GREEN=''
    readonly YELLOW=''
    readonly BLUE=''
    readonly BOLD=''
    readonly NC=''
fi

# Valid DCF modes (for validation)
readonly VALID_MODES="review checkpoint self-review refine debug unstick simplify diagnose architect tradeoffs assumptions premortem challenge decide learn onboard explain compact context-health retro skill"

# -----------------------------------------------------------------------------
# Workflow definitions (bash 3.2 compatible)
# -----------------------------------------------------------------------------

get_workflow() {
    local name="$1"
    case "$name" in
        new-project)        echo "onboard architect premortem" ;;
        debug)              echo "debug assumptions simplify" ;;
        decision)           echo "tradeoffs challenge decide" ;;
        learning)           echo "learn explain retro" ;;
        unstuck)            echo "diagnose unstick simplify" ;;
        session-end)        echo "context-health compact retro" ;;
        code-review)        echo "review assumptions challenge" ;;
        pre-implementation) echo "architect tradeoffs premortem" ;;
        *)                  echo "" ;;
    esac
}

is_workflow() {
    local name="$1"
    [[ -n "$(get_workflow "$name")" ]]
}

# -----------------------------------------------------------------------------
# Contextual checkpoint questions per workflow transition
# -----------------------------------------------------------------------------

get_checkpoint_questions() {
    local workflow="$1"
    local current_mode="$2"
    local next_mode="$3"
    local transition="${current_mode}→${next_mode}"

    case "$workflow" in
        new-project)
            case "$transition" in
                "onboard→architect")
                    printf "  • Do you understand the codebase structure and key patterns?\n"
                    printf "  • What constraints or tech debt did onboarding reveal?\n"
                    printf "  • Are there architectural decisions already baked in?\n"
                    ;;
                "architect→premortem")
                    printf "  • Is the architecture design complete and coherent?\n"
                    printf "  • What are the riskiest parts of this design?\n"
                    printf "  • What dependencies or integrations need special attention?\n"
                    ;;
            esac
            ;;
        debug)
            case "$transition" in
                "debug→assumptions")
                    printf "  • Is the bug's behavior clearly understood and reproducible?\n"
                    printf "  • What assumptions are you making about the root cause?\n"
                    printf "  • Have you ruled out environmental or data issues?\n"
                    ;;
                "assumptions→simplify")
                    printf "  • Did questioning assumptions reveal blind spots?\n"
                    printf "  • Can you reduce the problem scope further?\n"
                    printf "  • What's the minimal test case that reproduces this?\n"
                    ;;
            esac
            ;;
        decision)
            case "$transition" in
                "tradeoffs→challenge")
                    printf "  • Are all viable options on the table with clear tradeoffs?\n"
                    printf "  • What option are you leaning toward and why?\n"
                    printf "  • What's being overlooked or underweighted?\n"
                    ;;
                "challenge→decide")
                    printf "  • Have the options been stress-tested against edge cases?\n"
                    printf "  • Are there reversibility concerns with any option?\n"
                    printf "  • Ready to commit, or need more information?\n"
                    ;;
            esac
            ;;
        learning)
            case "$transition" in
                "learn→explain")
                    printf "  • Do you understand the concept well enough to explain it?\n"
                    printf "  • What mental models or analogies help clarify this?\n"
                    printf "  • What aspects are still fuzzy?\n"
                    ;;
                "explain→retro")
                    printf "  • Did explaining reveal gaps in understanding?\n"
                    printf "  • What would you teach differently next time?\n"
                    printf "  • How does this connect to what you already knew?\n"
                    ;;
            esac
            ;;
        unstuck)
            case "$transition" in
                "diagnose→unstick")
                    printf "  • Is the root cause of being stuck identified?\n"
                    printf "  • Is this a knowledge gap, tooling issue, or unclear requirements?\n"
                    printf "  • What's the single biggest blocker right now?\n"
                    ;;
                "unstick→simplify")
                    printf "  • Did the unsticking reveal a path forward?\n"
                    printf "  • Can the approach be simplified further?\n"
                    printf "  • What can be deferred or eliminated entirely?\n"
                    ;;
            esac
            ;;
        session-end)
            case "$transition" in
                "context-health→compact")
                    printf "  • Is the context still coherent or has it drifted?\n"
                    printf "  • What key decisions and findings must be preserved?\n"
                    printf "  • What can be safely forgotten?\n"
                    ;;
                "compact→retro")
                    printf "  • Is SESSION_FINDINGS.md ready for the next session?\n"
                    printf "  • What worked well this session?\n"
                    printf "  • What would you do differently?\n"
                    ;;
            esac
            ;;
        code-review)
            case "$transition" in
                "review→assumptions")
                    printf "  • Does the code do what it claims to do?\n"
                    printf "  • What assumptions is this code making about inputs/state?\n"
                    printf "  • Are there obvious bugs, security issues, or edge cases?\n"
                    ;;
                "assumptions→challenge")
                    printf "  • Did assumption-questioning reveal hidden risks?\n"
                    printf "  • What alternative approaches could work better?\n"
                    printf "  • Is this code solving the right problem?\n"
                    ;;
            esac
            ;;
        pre-implementation)
            case "$transition" in
                "architect→tradeoffs")
                    printf "  • Is the high-level architecture defined?\n"
                    printf "  • What key technical decisions need to be made?\n"
                    printf "  • What are the integration points and dependencies?\n"
                    ;;
                "tradeoffs→premortem")
                    printf "  • Are the tradeoffs understood and documented?\n"
                    printf "  • Which decisions are reversible vs. one-way doors?\n"
                    printf "  • What could cause this implementation to fail?\n"
                    ;;
            esac
            ;;
        *)
            # Generic fallback for custom workflows
            printf "  • Did the previous mode achieve its outcome?\n"
            printf "  • What insights emerged that inform the next step?\n"
            printf "  • Should you branch to a different mode instead?\n"
            ;;
    esac
}

# -----------------------------------------------------------------------------
# Utility functions
# -----------------------------------------------------------------------------

print_error() {
    printf "${RED}Error: %s${NC}\n" "$1" >&2
}

print_warning() {
    printf "${YELLOW}Warning: %s${NC}\n" "$1" >&2
}

print_line() {
    printf "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
}

is_valid_mode() {
    local mode="$1"
    local valid
    for valid in $VALID_MODES; do
        [[ "$valid" == "$mode" ]] && return 0
    done
    return 1
}

copy_to_clipboard() {
    local text="$1"

    if command -v pbcopy &>/dev/null; then
        printf "%s" "$text" | pbcopy
        return 0
    elif command -v xclip &>/dev/null; then
        printf "%s" "$text" | xclip -selection clipboard
        return 0
    elif command -v xsel &>/dev/null; then
        printf "%s" "$text" | xsel --clipboard --input
        return 0
    fi
    return 1
}

# -----------------------------------------------------------------------------
# Display functions
# -----------------------------------------------------------------------------

show_help() {
    printf '%b' "${BOLD}DCF Workflow Runner${NC} v${VERSION}

${YELLOW}CAUTION: Workflows are scaffolding, not standard practice.${NC}
Each transition should be a genuine checkpoint—\"Is this the right next mode?\"
The goal is to internalize when each mode fits, then choose deliberately.

${BOLD}Usage:${NC}
    ${SCRIPT_NAME} <workflow|modes...> [context]
    ${SCRIPT_NAME} [options]

${BOLD}Predefined Workflows:${NC}
    new-project        onboard → architect → premortem
    debug              debug → assumptions → simplify
    decision           tradeoffs → challenge → decide
    learning           learn → explain → retro
    unstuck            diagnose → unstick → simplify
    session-end        context-health → compact → retro
    code-review        review → assumptions → challenge
    pre-implementation architect → tradeoffs → premortem

${BOLD}Custom Workflow:${NC}
    ${SCRIPT_NAME} debug simplify decide \"investigating auth bug\"

${BOLD}Options:${NC}
    -h, --help       Show this help
    -l, --list       List available workflows
    -d, --dry-run    Show what would be executed
    -v, --version    Show version
    --modes          List all valid DCF modes

${BOLD}Examples:${NC}
    ${SCRIPT_NAME} new-project
    ${SCRIPT_NAME} decision \"API design choice\"
    ${SCRIPT_NAME} learn premortem \"starting new feature\"
    ${SCRIPT_NAME} --dry-run debug
"
}

show_version() {
    printf "%s v%s\n" "$SCRIPT_NAME" "$VERSION"
}

list_workflows() {
    printf "${BOLD}Available Workflows:${NC}\n\n"
    printf "  ${GREEN}%-20s${NC} %s\n" "code-review" "review → assumptions → challenge"
    printf "  ${GREEN}%-20s${NC} %s\n" "debug" "debug → assumptions → simplify"
    printf "  ${GREEN}%-20s${NC} %s\n" "decision" "tradeoffs → challenge → decide"
    printf "  ${GREEN}%-20s${NC} %s\n" "learning" "learn → explain → retro"
    printf "  ${GREEN}%-20s${NC} %s\n" "new-project" "onboard → architect → premortem"
    printf "  ${GREEN}%-20s${NC} %s\n" "pre-implementation" "architect → tradeoffs → premortem"
    printf "  ${GREEN}%-20s${NC} %s\n" "session-end" "context-health → compact → retro"
    printf "  ${GREEN}%-20s${NC} %s\n" "unstuck" "diagnose → unstick → simplify"
}

list_modes() {
    printf "${BOLD}Valid DCF Modes:${NC}\n\n"

    printf "${GREEN}Evaluation & Review:${NC}\n"
    printf "  review, checkpoint, self-review, refine\n\n"

    printf "${GREEN}Problem Solving:${NC}\n"
    printf "  debug, unstick, simplify, diagnose\n\n"

    printf "${GREEN}Design & Analysis:${NC}\n"
    printf "  architect, tradeoffs, assumptions, premortem, challenge, decide\n\n"

    printf "${GREEN}Learning & Exploration:${NC}\n"
    printf "  learn, onboard, explain\n\n"

    printf "${GREEN}Session Management:${NC}\n"
    printf "  compact, context-health, retro, skill\n"
}

# -----------------------------------------------------------------------------
# Core workflow functions
# -----------------------------------------------------------------------------

display_mode() {
    local mode="$1"
    local context="${2:-}"
    local cmd

    print_line
    printf "${GREEN}▶ DCF Mode: %s${NC}\n" "$mode"
    if [[ -n "$context" ]]; then
        printf "${YELLOW}  Context: %s${NC}\n" "$context"
    fi
    print_line
    printf "\n"

    # Build the command
    if [[ -n "$context" ]]; then
        cmd="/dcf ${mode} ${context}"
    else
        cmd="/dcf ${mode}"
    fi

    printf "${YELLOW}Run in Claude Code:${NC}\n\n"
    printf "  %s\n\n" "$cmd"

    # Copy to clipboard if available
    if copy_to_clipboard "$cmd"; then
        printf "${GREEN}(Copied to clipboard)${NC}\n"
    fi
    printf "\n"
}

show_checkpoint() {
    local workflow="$1"
    local current_mode="$2"
    local next_mode="$3"

    printf "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
    printf "${YELLOW}▋ CHECKPOINT${NC}\n\n"
    printf "  Before proceeding to '%s':\n" "$next_mode"
    get_checkpoint_questions "$workflow" "$current_mode" "$next_mode"
    printf "\n"
    read -r -p "  Press Enter to continue, or Ctrl+C to stop... "
    printf "\n"
}

display_plan() {
    local context="$1"
    shift
    local modes_str="$*"

    printf "\n"
    printf "${GREEN}DCF Workflow${NC}\n"
    printf "${GREEN}════════════${NC}\n\n"
    printf "  Sequence: %s\n" "${modes_str// / → }"
    if [[ -n "$context" ]]; then
        printf "  Context:  %s\n" "$context"
    fi
    printf "\n"
}

run_workflow() {
    local workflow="$1"
    local context="$2"
    shift 2
    local modes=("$@")
    local mode next_mode
    local i
    local count=${#modes[@]}

    printf "${YELLOW}This workflow has %d steps with checkpoints between each.${NC}\n" "$count"
    read -r -p "Press Enter to begin... "
    printf "\n"

    for (( i=0; i<count; i++ )); do
        mode="${modes[$i]}"

        display_mode "$mode" "$context"

        # Checkpoint between modes (not after last)
        if (( i < count - 1 )); then
            next_mode="${modes[$((i + 1))]}"
            show_checkpoint "$workflow" "$mode" "$next_mode"
        fi
    done

    printf "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
    printf "${GREEN}✓ Workflow complete${NC}\n"
    printf "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------

main() {
    local dry_run=false
    local modes=()
    local context=""
    local workflow_name="custom"
    local arg
    local workflow_modes
    local positional_args=()

    # First pass: separate options from positional args
    while (( $# > 0 )); do
        arg="$1"
        case "$arg" in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--version)
                show_version
                exit 0
                ;;
            -l|--list)
                list_workflows
                exit 0
                ;;
            --modes)
                list_modes
                exit 0
                ;;
            -d|--dry-run)
                dry_run=true
                ;;
            -*)
                print_error "Unknown option: $arg"
                printf "Use --help for usage information.\n" >&2
                exit 1
                ;;
            *)
                positional_args+=("$arg")
                ;;
        esac
        shift
    done

    # Second pass: process positional arguments
    # Count how many look like modes vs context
    local mode_count=0
    for arg in "${positional_args[@]}"; do
        if [[ "$arg" =~ ^[a-z-]+$ ]] && (( ${#arg} < 20 )); then
            (( mode_count++ ))
        fi
    done

    for arg in "${positional_args[@]}"; do
        if [[ "$arg" =~ ^[a-z-]+$ ]] && (( ${#arg} < 20 )); then
            # If only one mode-like arg and it's a workflow, expand it
            if (( mode_count == 1 )) && is_workflow "$arg" && (( ${#modes[@]} == 0 )); then
                workflow_name="$arg"
                workflow_modes="$(get_workflow "$arg")"
                read -ra modes <<< "$workflow_modes"
            elif is_valid_mode "$arg"; then
                modes+=("$arg")
            elif is_workflow "$arg" && (( ${#modes[@]} == 0 )); then
                # Workflow name that's not also a mode (e.g., new-project)
                workflow_name="$arg"
                workflow_modes="$(get_workflow "$arg")"
                read -ra modes <<< "$workflow_modes"
            else
                print_warning "Unknown mode '$arg' - treating as context"
                context="$arg"
            fi
        else
            # Treat as context
            context="$arg"
        fi
    done

    # Validate
    if (( ${#modes[@]} == 0 )); then
        print_error "No workflow or modes specified"
        printf "\n"
        show_help
        exit 1
    fi

    # Display plan
    display_plan "$context" "${modes[@]}"

    if [[ "$dry_run" == "true" ]]; then
        printf "${YELLOW}(Dry run - no execution)${NC}\n"
        exit 0
    fi

    # Run
    run_workflow "$workflow_name" "$context" "${modes[@]}"
}

main "$@"
